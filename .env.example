# Copy this file to .env next to docker-compose.yml and fill it in. Never commit .env,
# and never paste it into a chat, an issue or a shared document.
#
# Required. Anyone who has this token can set off the wearables. Use a long random
# value, for example the output of:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
HALOW_TOKEN=

# Optional. The container runs as the owner of ./data, uid and gid 1000 by default.
# If `id -u` or `id -g` print something else on this machine, set them here:
# HALOW_UID=1000
# HALOW_GID=1000

# Optional service settings, shown with their defaults (docs/HTTP-API.md, "Service settings").
# HALOW_IFACE=192.168.12.50
# HALOW_HTTP=0.0.0.0:8080
# HALOW_FORMAT=raw8
# HALOW_BURST_SECONDS=0
# HALOW_HEARTBEAT=15
# HALOW_LOG=/data/halow-alert.jsonl
# An empty HALOW_LOG= turns the log off.
# An empty HALOW_IFACE= picks the HaLowLink address automatically instead of 192.168.12.50.

# Network settings. They must match the wearables: change them only if ClearObject says so.
# HALOW_ROUTER=192.168.12.1
# HALOW_GROUP=239.255.0.10
# HALOW_PORT=5000
# HALOW_RESPONSE_PORT=5001
# HALOW_TTL=4
